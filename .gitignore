# =============================================================================
# GitHubIQ — .gitignore
# Never commit secrets, dependencies, or build outputs.
# =============================================================================

# --- Environment files (secrets!) ---
.env
.env.local
.env.*.local
backend/.env
frontend/.env

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
pip-log.txt
pip-delete-this-directory.txt
.tox/
.coverage
.coverage.*
.pytest_cache/
htmlcov/

# --- Virtual environments ---
venv/
.venv/
env/
.env/

# --- Node / frontend ---
node_modules/
.npm
.eslintcache
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
coverage/
dist/
build/
.next/
out/
.turbo/

# --- IDE / editors ---
.vscode/
.idea/
*.swp
*.swo
*~
*.code-workspace

# --- OS ---
.DS_Store
Thumbs.db

# --- Misc ---
*.pem
*.key
.terraform/
