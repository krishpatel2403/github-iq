# =============================================================================
# GitHubIQ — Environment variables
# =============================================================================
# Copy this file to .env (never commit .env) and fill in real values.
# Backend reads backend/.env; frontend reads frontend/.env.
# This file is documentation only.

# -----------------------------------------------------------------------------
# 1. GitHub OAuth App (create one at https://github.com/settings/developers/new)
#    - Homepage URL:        http://localhost:8000
#    - Authorization callback URL: http://localhost:8000/api/v1/auth/github/callback
# -----------------------------------------------------------------------------
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:8000/api/v1/auth/github/callback
FRONTEND_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# 2. Fernet key — encrypts GitHub access tokens at rest.
#    Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# -----------------------------------------------------------------------------
GITHUB_TOKEN_ENCRYPTION_KEY=your_fernet_key_here

# -----------------------------------------------------------------------------
# 3. Session secret — signs the signed session cookie.
#    Generate: openssl rand -hex 32
# -----------------------------------------------------------------------------
SESSION_SECRET_KEY=your_session_secret_here

# -----------------------------------------------------------------------------
# 4. App configuration
# -----------------------------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=5173
FRONTEND_URL=http://localhost:5173
DATABASE_URL=sqlite:///./data/app.db
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# 5. Production overrides (set these when deploying)
# -----------------------------------------------------------------------------
# ENVIRONMENT=production
# SECRET_KEY=change-me-in-production
# CORS_ORIGINS=https://your-app.vercel.app
